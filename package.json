{
  "name": "@levelcap/import-plan",
  "version": "0.1.0",
  "description": "Generate safe, deterministic data import plans (creates / updates / unchanged / conflicts) by diffing two record arrays. Zero runtime dependencies.",
  "keywords": [
    "import",
    "upsert",
    "diff",
    "merge",
    "reconcile",
    "sync",
    "deduplicate",
    "conflict",
    "data",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true });\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:fixup": "node scripts/postbuild.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:fixup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "LevelCap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevelCapTech/import-plan.git"
  },
  "homepage": "https://github.com/LevelCapTech/import-plan#readme",
  "bugs": {
    "url": "https://github.com/LevelCapTech/import-plan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
